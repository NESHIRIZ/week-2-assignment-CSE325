@model IEnumerable<TafadzwaMovies.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<div class="container mt-4">
    <!-- Search & Filter Card -->
    <div class="search-card">
        <h5 style="color: #1a237e; margin-bottom: 20px; font-weight: 700;">🔍 Search & Filter Movies</h5>
        <form asp-action="Index" method="get">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="searchString" class="form-label">Search by Title</label>
                    <input type="text" id="searchString" name="searchString" 
                           class="form-control" placeholder="e.g., Lion King, Panther..."
                           value="@ViewData["searchString"]" />
                </div>

                <div class="col-md-4 mb-3">
                    <label for="movieYear" class="form-label">Release Year (or newer)</label>
                    <select id="movieYear" name="movieYear" class="form-select">
                        <option value="">-- All Years --</option>
                        <option value="2024">2024 or newer</option>
                        <option value="2020">2020 or newer</option>
                        <option value="2015">2015 or newer</option>
                        <option value="2010">2010 or newer</option>
                        <option value="2000">2000 or newer</option>
                        <option value="1990">1990 or newer</option>
                        <option value="1980">1980 or newer</option>
                    </select>
                </div>

                <div class="col-md-4 d-flex align-items-end mb-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Add New Movie Button -->
    <div class="mb-4">
        <a href="@Url.Action("Create")" class="btn btn-success btn-lg">
            <i class="fas fa-plus"></i> Add New Movie
        </a>
    </div>

    <!-- Movies Table -->
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">🎬 Title</th>
                        <th scope="col">📅 Release Date</th>
                        <th scope="col">🎭 Genre</th>
                        <th scope="col">💰 Price</th>
                        <th scope="col">⭐ Rating</th>
                        <th scope="col">⚙️ Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Title</strong>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.ReleaseDate.ToString("MMM d, yyyy")</span>
                            </td>
                            <td>
                                <span style="color: #ff6f00; font-weight: 600;">@item.Genre</span>
                            </td>
                            <td>
                                <span style="color: #4caf50; font-weight: 600; font-size: 16px;">$@item.Price.ToString("F2")</span>
                            </td>
                            <td>
                                <span class="badge bg-info" style="font-size: 13px; padding: 8px 12px;">@item.Rating</span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-info" title="View Details">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-danger" title="Delete">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="text-align: center; margin-top: 20px; color: #666;">
            <small>Showing <strong>@Model.Count()</strong> movie(s)</small>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert" style="text-align: center; padding: 40px;">
            <h4 style="color: #0277bd; margin-bottom: 10px;">🎬 No Movies Found</h4>
            <p style="margin-bottom: 20px;">Try adjusting your search filters or add a new movie to get started!</p>
            <a href="@Url.Action("Create")" class="btn btn-success">
                <i class="fas fa-plus"></i> Add Your First Movie
            </a>
        </div>
    }
</div>
