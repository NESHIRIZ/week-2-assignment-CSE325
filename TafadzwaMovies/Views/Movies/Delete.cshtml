@model TafadzwaMovies.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="search-card" style="border-left-color: #f44336;">
                <h2 style="color: #f44336; margin-bottom: 30px; font-weight: 700;">
                    <i class="fas fa-exclamation-triangle"></i> Delete Movie
                </h2>

                <div class="alert alert-warning" role="alert" style="border-radius: 8px;">
                    <strong>⚠️ Warning!</strong> You are about to permanently delete this movie. This action cannot be undone.
                </div>

                <div class="mb-4">
                    <label class="form-label" style="color: #666; font-size: 12px; text-transform: uppercase;">Movie Title</label>
                    <h4 style="color: #ff6f00; font-weight: 700; margin: 0; padding: 15px; background: #f5f5f5; border-radius: 8px;">
                        @Model.Title
                    </h4>
                </div>

                <div class="mb-4">
                    <label class="form-label" style="color: #666; font-size: 12px; text-transform: uppercase;">Release Date</label>
                    <p style="margin: 0; padding: 10px 0;">@Model.ReleaseDate.ToString("MMMM d, yyyy")</p>
                </div>

                <div class="mb-4">
                    <label class="form-label" style="color: #666; font-size: 12px; text-transform: uppercase;">Genre</label>
                    <p style="margin: 0; padding: 10px 0;">@Model.Genre</p>
                </div>

                <hr style="border-color: #e0e0e0; margin: 30px 0;">

                <h5 style="color: #d32f2f; margin-bottom: 20px; font-weight: 600;">
                    Are you sure you want to delete this movie?
                </h5>

                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash-alt"></i> Yes, Delete Permanently
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
